---
import BaseLayout from '../layouts/BaseLayout.astro';

// Title follows CITATION.cff and the Zenodo record (the concept DOI resolves to the latest version)
const bibtex = `@software{aggarwal2026qualilens,
  author    = {Aggarwal, Ashita and Commuri, Suraj},
  title     = {{QualiLens: A local application for LLM-assisted qualitative data analysis}},
  year      = {2026},
  publisher = {Zenodo},
  doi       = {10.5281/zenodo.22191913},
  url       = {https://doi.org/10.5281/zenodo.22191913}
}`;
---

<BaseLayout title="QualiLens — LLM-Assisted Qualitative Data Analysis">

  <!-- Hero: the claim, then the evidence for it -->
  <section class="hero">
    <div class="max-w-6xl mx-auto px-6">
      <div class="hero-grid">
        <h1>Qualitative analysis with <span class="l2"><span class="mark-hl">AI you can audit.</span></span></h1>
        <p class="lede">QualiLens runs five established qualitative methods — from grounded theory to literature synthesis — with LLM coding that pauses for your review, keeps verbatim provenance on all excerpts, and stays entirely on your machine.</p>
        <div class="hero-aside">
          <div class="actions">
            <a class="btn btn-ink" href="/download">Get QualiLens</a>
            <a class="link link-strong" href="/features">See how it works →</a>
          </div>
          <ul class="meta">
            <li>Free and open source, Apache 2.0</li>
            <li>Mac with Apple silicon, Linux, or Windows via WSL</li>
            <li class="who">Ashita Aggarwal and Suraj Commuri</li>
            <li><a href="https://doi.org/10.5281/zenodo.22191913">doi:10.5281/zenodo.22191913</a> · <a href="#cite">How to cite</a></li>
          </ul>
        </div>
      </div>

      <figure class="hero-figure">
        <!-- opens the whole reader screen this crop was cut from (a double-resolution capture, 1400 CSS px wide) -->
        <a class="zoom" href="/screenshots/app-coded-source-reader-2x.png" data-figure data-w="1400" data-h="1362"><div class="shot">
          <picture>
            <source media="(max-width: 600px)" srcset="/screenshots/app-coded-source-reader-crop-phone.png" width="896" height="475" />
            <img src="/screenshots/app-coded-source-reader-crop.png" width="1400" height="724" alt="QualiLens coded-source reader: interview transcript with coded passages shaded in gold, minimap along the left edge, and a code panel listing all codes in the document" />
          </picture>
        </div></a>
        <figcaption class="caption"><b>The coded-source reader.</b> Each coded passage is shaded where it occurs in the transcript<span class="wide-only">, with every code in the document listed beside it</span>. Quotes in the report link back to these exact positions.</figcaption>
      </figure>
    </div>
  </section>

  <!-- Workflow -->
  <section class="block" id="workflow">
    <div class="max-w-6xl mx-auto px-6 split">
      <div>
        <h2>Five steps to a complete analysis</h2>
        <p class="intro">A five-step wizard handles method selection, configuration, model choice, data upload, and cost estimation. The pipeline then runs, pausing at each checkpoint for your review.</p>
      </div>
      <ol class="steps">
        <li><h3>Choose a method</h3><p>Grounded theory, thematic analysis, content analysis, framework coding, or literature synthesis.</p></li>
        <li><h3>Configure</h3><p>Set your research question, method-specific options, and any codebook or framework.</p></li>
        <li><h3>Pick a model</h3><p>Anthropic, OpenAI, Google, or Mistral — your key, your account, direct connection.</p></li>
        <li><h3>Upload data</h3><p>Drag in documents, PDFs, or recordings. Transcription runs automatically.</p></li>
        <li><h3>Review &amp; run</h3><p>See a cost estimate, start the pipeline, and approve each checkpoint.</p></li>
      </ol>
    </div>
  </section>

  <!-- Methods -->
  <section class="block" id="methods">
    <div class="max-w-6xl mx-auto px-6">
      <h2>Five established methods</h2>
      <p class="intro">Each method follows its own epistemology. QualiLens implements distinct pipelines with method-appropriate stages, checkpoints, and figures.</p>
      <table class="methods">
        <colgroup><col style="width:19%" /><col style="width:32%" /><col style="width:29%" /><col style="width:20%" /></colgroup>
        <thead>
          <tr><th scope="col">Method</th><th scope="col">Stages</th><th scope="col">Checkpoints</th><th scope="col">Report figure</th></tr>
        </thead>
        <tbody>
          <tr><th scope="row">Grounded theory</th><td data-label="Stages">Familiarization, open coding, axial coding, selective coding</td><td data-label="Checkpoints">Code review, core category, theoretical model</td><td data-label="Report figure">Paradigm flow model</td></tr>
          <tr><th scope="row">Thematic analysis</th><td data-label="Stages">Familiarization, initial coding, theme construction, theme review</td><td data-label="Checkpoints">Code review, theme refinement</td><td data-label="Report figure">Thematic map</td></tr>
          <tr><th scope="row">Content analysis</th><td data-label="Stages">Codebook derivation or import, systematic coding</td><td data-label="Checkpoints">Codebook approval, frequency review</td><td data-label="Report figure">Frequency bar chart</td></tr>
          <tr><th scope="row">Framework coding</th><td data-label="Stages">Apply framework, chart by source, build matrix</td><td data-label="Checkpoints">Low-confidence review, emergent codes, matrix</td><td data-label="Report figure">Framework heatmap</td></tr>
          <tr><th scope="row">Literature synthesis</th><td data-label="Stages">Structured extraction, cross-paper synthesis, concept matrix</td><td data-label="Checkpoints">Extraction table, concept review</td><td data-label="Report figure">Concept-by-paper heatmap</td></tr>
        </tbody>
      </table>
      <div class="note-row">
        <p><strong>Built for researchers.</strong> Each method follows published methodological commitments. The wizard records your choices verbatim, so you have a record for the methods section.</p>
        <a class="link link-strong" href="/features">Explore all features →</a>
      </div>
      <figure class="method-figure">
        <a class="zoom" href="/screenshots/app-grounded-theory-model.png" data-figure data-w="1079" data-h="792"><div class="shot"><img src="/screenshots/app-grounded-theory-model.png" width="1079" height="792" alt="QualiLens report figure for a grounded-theory run: a paradigm flow model in which five categories on the left lead into the core category, Pursuing emotionally satisfying treat experiences within everyday constraints, with two categories to its right" loading="lazy" /></div></a>
        <figcaption class="caption"><b>A report figure.</b> The paradigm flow model from a grounded-theory run on a sample interview. Conditions, context, and dimensions sit to the left of the core category, strategies and consequences to its right, and each category prints its relationship to the core verbatim.</figcaption>
      </figure>
    </div>
  </section>

  <!-- Differences: claims beside evidence -->
  <section class="block" id="why">
    <div class="max-w-6xl mx-auto px-6">
      <h2>What makes QualiLens different</h2>
      <p class="intro">Established CAQDAS platforms host your data on their servers or require per-seat licenses. QualiLens is open source, runs locally, and replaces manual coding with auditable LLM-assisted coding behind researcher-controlled checkpoints.</p>

      <div class="diff-grid">
        <figure class="diff-figure">
          <!-- opens the whole checkpoint screen this crop was cut from -->
          <a class="zoom" href="/screenshots/app-checkpoint-evidence.png" data-figure data-w="1400" data-h="1135"><div class="shot"><img src="/screenshots/app-checkpoint-evidence-crop.png" width="1060" height="872" alt="QualiLens checkpoint: concepts under review, each beside a verbatim quote and the papers that support it" loading="lazy" /></div></a>
          <figcaption class="caption"><b>A checkpoint.</b> The pipeline waits while you rename, merge, or delete concepts. Each one shows the papers and verbatim quotes behind it.</figcaption>
        </figure>
        <div class="claims">
          <div><h3>Researcher-led checkpoints</h3><p>The pipeline pauses at each analytic decision point. Your edits are final and are not overwritten by later automated stages.</p></div>
          <div><h3>Provenance on all excerpts</h3><p>Each coded passage stores the verbatim quote and its character position. The coded-source reader draws coding over each document in place.</p></div>
          <div><h3>Full audit trail</h3><p>All stage boundaries, model calls, and researcher decisions are logged. The report appendix reproduces this trail for reviewers.</p></div>
          <div><h3>Runs locally</h3><p>No QualiLens server. Your data go only to the AI provider you chose, over a direct API connection. Nothing is collected.</p></div>
          <div><h3>Four providers, your key</h3><p>Anthropic, OpenAI, Google, and Mistral. Cost estimation before each run, and resumable runs that don't re-bill finished work.</p></div>
          <div><h3>Reports and Word export</h3><p>Interactive report with narrative sections, method-appropriate figures, full evidence chains, and one-click Word export.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Privacy + start -->
  <section class="block" id="start">
    <div class="max-w-6xl mx-auto px-6 pair">
      <div>
        <h2>Your data stay on your computer.</h2>
        <p>No QualiLens server, no telemetry, no analytics, no background connections. Analysis calls go directly to the provider whose key you supplied — and nowhere else.</p>
        <a class="link link-strong" href="/privacy">Read the full privacy statement →</a>
      </div>
      <div>
        <h2>Ready to start?</h2>
        <p>QualiLens requires a Mac with Apple silicon or a Linux computer (on Windows, WSL), Python 3.11+, and an API key from any supported provider. A single-document analysis typically costs a few cents.</p>
        <div class="actions">
          <a class="btn btn-ink" href="/getting-started">Getting started guide</a>
          <a class="btn btn-line" href="https://github.com/iconerr/qualilens" target="_blank" rel="noopener">View on GitHub</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Cite (moved up from the footer; title follows CITATION.cff and the Zenodo record) -->
  <section class="cite" id="cite">
    <div class="max-w-6xl mx-auto px-6 cite-grid">
      <div>
        <h2 id="cite-heading" tabindex="-1">Cite QualiLens</h2>
        <p class="cite-sub">If QualiLens contributed to your analysis, please cite the software.</p>
      </div>
      <div>
        <p class="ref" id="ref-apa">Aggarwal, A., &amp; Commuri, S. (2026). <em>QualiLens: A local application for LLM-assisted qualitative data analysis</em> [Computer software]. Zenodo. <a class="link" href="https://doi.org/10.5281/zenodo.22191913">https://doi.org/10.5281/zenodo.22191913</a></p>
        <div class="ref-actions">
          <button class="copy-cite" type="button" data-copy="ref-apa">Copy APA</button>
          <button class="copy-cite" type="button" data-copy="ref-bibtex">Copy BibTeX</button>
          <span id="cite-status" aria-live="polite"></span>
        </div>
        <details class="bib">
          <summary>Show BibTeX</summary>
          <pre id="ref-bibtex">{bibtex}</pre>
        </details>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const status = document.getElementById('cite-status');
  document.querySelectorAll<HTMLButtonElement>('.copy-cite').forEach(btn => btn.addEventListener('click', async () => {
    const source = document.getElementById(btn.dataset.copy || '');
    if (!source || !status) return;
    const text = (source.textContent || '').replace(/\s+\n/g, '\n').trim();
    try { await navigator.clipboard.writeText(text); status.textContent = btn.textContent?.replace('Copy ', '') + ' copied.'; }
    catch { status.textContent = 'Select the text to copy it.'; }
    setTimeout(() => { status.textContent = ''; }, 2400);
  }));

  // "How to cite" (in the hero and the footer) and arrivals at /#cite: bring the
  // Cite section to the bottom of the window and mark the reference briefly in
  // the reader's gold, so the link visibly does something even when the section
  // is already in view (at the foot of the page the browser cannot scroll further).
  const cite = document.getElementById('cite');
  const ref = document.getElementById('ref-apa');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  function showCite(animate: boolean) {
    if (!cite || !ref) return;
    // move focus to the heading (for screen readers) without scrolling, then scroll
    document.getElementById('cite-heading')?.focus({ preventScroll: true });
    cite.scrollIntoView({ block: 'end', behavior: animate && !reduceMotion ? 'smooth' : 'instant' });
    ref.classList.remove('flash'); void ref.offsetWidth; ref.classList.add('flash');
  }
  document.addEventListener('click', e => {
    const a = (e.target as Element | null)?.closest?.('a[href="#cite"], a[href="/#cite"]');
    if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    e.preventDefault();
    if (location.hash !== '#cite') history.pushState(null, '', '#cite');
    showCite(true);
  });
  if (location.hash === '#cite') {
    if (document.readyState === 'complete') showCite(false);
    else addEventListener('load', () => showCite(false), { once: true });
  }
</script>

<style>
  /* hero */
  .hero { padding-top: 72px; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: 28px 64px; align-items: start; }
  .hero h1 { font-size: clamp(36px, 4.6vw, 56px); line-height: 1.1; letter-spacing: -0.012em; grid-column: 1 / -1; text-wrap: balance; }
  @media (min-width: 360px) { .hero h1 .mark-hl { white-space: nowrap; } }
  @media (min-width: 761px) { .hero h1 .l2 { display: block; } }
  .mark-hl {
    background: linear-gradient(to bottom, transparent 14%, var(--color-highlight) 14%, var(--color-highlight) 94%, transparent 94%);
    -webkit-box-decoration-break: clone; box-decoration-break: clone; padding: 0 .06em;
  }
  .lede { font-size: 19px; line-height: 1.6; color: var(--color-text-secondary); max-width: 40em; }
  .hero-aside { display: grid; gap: 20px; padding-top: 4px; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
  .meta { list-style: none; margin: 0; padding: 14px 0 0; border-top: 1px solid var(--color-rule); display: grid; gap: 3px; font-size: 14px; line-height: 1.5; color: var(--color-text-muted); }
  .meta a { color: var(--color-text-secondary); text-decoration: underline; text-decoration-color: var(--color-rule-strong); text-underline-offset: 3px; }
  .meta a:hover { color: var(--color-brand-500); }
  .meta .who { color: var(--color-text-secondary); }
  .hero-figure { margin: 56px 0 0; }
  @media (max-width: 600px) { .wide-only { display: none; } }

  /* sections */
  .block { padding: 88px 0; border-top: 1px solid var(--color-rule); }
  .hero + .block { margin-top: 88px; }
  .block h2 { font-size: clamp(28px, 3vw, 34px); line-height: 1.2; }
  .intro { font-size: 17px; line-height: 1.65; color: var(--color-text-secondary); max-width: 38em; margin-top: 14px; }
  .split { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 32px 72px; align-items: start; }

  /* workflow */
  .steps { list-style: none; margin: 0; padding: 0; counter-reset: step; border-top: 1px solid var(--color-ink); }
  .steps li { counter-increment: step; display: grid; grid-template-columns: 40px minmax(0, 11rem) minmax(0, 1fr); gap: 16px; padding: 18px 0; border-bottom: 1px solid var(--color-rule); align-items: baseline; }
  .steps li::before { content: counter(step); font-family: var(--font-serif); font-size: 22px; color: var(--color-text-muted); line-height: 1; }
  .steps h3 { font-size: 16px; font-weight: 600; }
  .steps p { color: var(--color-text-secondary); }

  /* methods table */
  table.methods { width: 100%; margin-top: 36px; border-collapse: collapse; font-size: 15px; line-height: 1.5; background: #fff; border: 1px solid var(--color-rule); }
  .methods th, .methods td { text-align: left; vertical-align: top; padding: 16px 20px; border-bottom: 1px solid var(--color-rule); }
  .methods thead th { font-size: 13px; font-weight: 500; color: var(--color-text-muted); background: var(--color-panel); border-bottom: 1px solid var(--color-rule-strong); padding-top: 12px; padding-bottom: 12px; }
  .methods tbody th { font-family: var(--font-serif); font-weight: 500; font-size: 17px; }
  .methods tbody tr:last-child > * { border-bottom: 0; }
  .methods td { color: var(--color-text-secondary); }
  .method-figure { margin: 40px 0 0; display: grid; grid-template-columns: minmax(0, 600px) minmax(0, 1fr); gap: 16px 48px; align-items: end; }
  .method-figure .caption { margin-top: 0; padding-top: 14px; border-top: 1px solid var(--color-rule); max-width: 30em; }
  @media (max-width: 960px) {
    .method-figure { grid-template-columns: 1fr; }
    .method-figure .caption { padding-top: 0; border-top: 0; }
  }
  .note-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px 40px; align-items: baseline; margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--color-rule); }
  .note-row p { color: var(--color-text-secondary); max-width: 46em; }
  .note-row strong { color: var(--color-ink); font-weight: 600; }

  /* differences */
  .diff-grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 40px 64px; margin-top: 44px; align-items: start; }
  .diff-figure { margin: 0; position: sticky; top: 88px; }
  .claims { border-top: 1px solid var(--color-ink); }
  .claims div { padding: 18px 0; border-bottom: 1px solid var(--color-rule); }
  .claims h3 { font-size: 16px; font-weight: 600; margin-bottom: 4px; }
  .claims p { color: var(--color-text-secondary); font-size: 15.5px; }

  /* privacy + start */
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 48px 72px; }
  .pair p { color: var(--color-text-secondary); font-size: 17px; line-height: 1.65; margin: 14px 0 22px; max-width: 34em; }
  .pair .actions { gap: 12px; }

  /* cite */
  .cite { background: var(--color-panel); border-top: 1px solid var(--color-rule); padding: 56px 0; scroll-margin-top: 64px; }
  .cite-grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 20px 72px; align-items: start; }
  .cite h2 { font-size: 24px; }
  .cite-sub { color: var(--color-text-muted); font-size: 15px; margin-top: 8px; }
  .ref { font-family: var(--font-serif); font-size: 18px; line-height: 1.6; padding-left: 20px; border-left: 2px solid var(--color-rule-strong); overflow-wrap: anywhere; border-radius: 0 4px 4px 0; }
  .ref.flash { animation: cite-flash 1.8s ease-out; }
  @keyframes cite-flash {
    0%, 30% { background-color: var(--color-highlight); box-shadow: 0 0 0 6px var(--color-highlight); }
    100% { background-color: transparent; box-shadow: 0 0 0 6px transparent; }
  }
  #cite-heading:focus { outline: none; }
  .ref-actions { display: flex; flex-wrap: wrap; gap: 10px 12px; align-items: center; margin-top: 16px; padding-left: 22px; font-size: 14px; color: var(--color-text-muted); }
  .copy-cite { font: 500 14px/1 var(--font-sans); background: #fff; color: var(--color-ink); border: 1px solid var(--color-rule-strong); border-radius: 6px; padding: 8px 12px; cursor: pointer; }
  .copy-cite:hover { border-color: var(--color-ink); }
  .bib { margin: 14px 0 0 22px; font-size: 14px; color: var(--color-text-muted); }
  .bib summary { cursor: pointer; width: max-content; }
  .bib summary:hover { color: var(--color-ink); }
  .bib pre { margin: 10px 0 0; padding: 14px 16px; background: #fff; border: 1px solid var(--color-rule); border-radius: 6px; font: 400 13px/1.55 var(--font-mono); color: var(--color-text-secondary); overflow-x: auto; }

  /* responsive */
  @media (max-width: 960px) {
    .hero-grid, .split, .diff-grid, .pair, .cite-grid { grid-template-columns: 1fr; }
    .diff-figure { position: static; }
  }
  @media (max-width: 760px) {
    .hero { padding-top: 44px; }
    .lede { font-size: 17.5px; }
    .hero-figure { margin-top: 40px; }
    .block { padding: 60px 0; }
    .hero + .block { margin-top: 60px; }
    .steps li { grid-template-columns: 28px minmax(0, 1fr); }
    .steps li p { grid-column: 2; }
    .note-row { grid-template-columns: 1fr; }
    .methods, .methods tbody, .methods tr, .methods th, .methods td { display: block; width: 100%; }
    .methods colgroup { display: none; }
    .methods thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .methods tbody tr { border-bottom: 1px solid var(--color-rule); padding: 6px 0 10px; }
    .methods tbody tr:last-child { border-bottom: 0; }
    .methods tbody th { padding: 12px 16px 4px; border: 0; }
    .methods td { border: 0; padding: 4px 16px; }
    .methods td::before { content: attr(data-label); display: block; font-size: 13px; color: var(--color-text-muted); }
    .ref { font-size: 16.5px; }
  }
</style>
