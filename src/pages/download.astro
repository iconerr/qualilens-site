---
import BaseLayout from '../layouts/BaseLayout.astro';

const downloadUrl = "https://github.com/iconerr/qualilens/releases/latest/download/QualiLens.zip";
---

<BaseLayout title="Download — QualiLens" description="Download QualiLens and start your first analysis.">

  <section class="py-16 md:py-24">
    <div class="max-w-2xl mx-auto px-6 text-center">

      <h1 class="text-[34px] md:text-[42px] leading-tight mb-4">Your download should begin automatically.</h1>
      <p class="text-text-secondary text-lg mb-8">If it does not, <a href={downloadUrl} class="link">download QualiLens.zip directly</a>.</p>

      <div class="bg-white border border-rule rounded-md p-8 text-left mb-8">
        <h2 class="font-semibold text-ink mb-4">Next steps</h2>
        <ol class="space-y-3 text-sm text-text-secondary">
          <li class="flex gap-3">
            <span class="shrink-0 w-6 font-serif text-lg leading-5 text-text-muted text-center">1</span>
            <span>Unzip the downloaded file and place the folder wherever you like.</span>
          </li>
          <li class="flex gap-3">
            <span class="shrink-0 w-6 font-serif text-lg leading-5 text-text-muted text-center">2</span>
            <span>Open a terminal in the QualiLens folder and run <code class="code-inline">./run.sh</code></span>
          </li>
          <li class="flex gap-3">
            <span class="shrink-0 w-6 font-serif text-lg leading-5 text-text-muted text-center">3</span>
            <span>Add an API key in Settings (Anthropic, OpenAI, Google, or Mistral).</span>
          </li>
        </ol>
      </div>

      <a href="/getting-started" class="inline-flex items-center gap-2 link link-strong">
        Full getting started guide
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </a>
      <p class="text-sm text-text-muted mt-4">Already using QualiLens? <a href="/docs/whats-new" class="link">See what changed in the latest release</a>, then update from Settings.</p>
    </div>
  </section>

  <script define:vars={{ downloadUrl }}>
    // Start the download automatically after a short delay
    setTimeout(() => {
      window.location.href = downloadUrl;
    }, 500);
  </script>

</BaseLayout>
