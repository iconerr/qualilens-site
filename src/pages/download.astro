---
import BaseLayout from '../layouts/BaseLayout.astro';

const downloadUrl = "https://github.com/iconerr/qualilens/releases/latest/download/QualiLens.zip";
---

<BaseLayout title="Download — QualiLens" description="Download QualiLens and start your first analysis.">

  <!-- A short visit with one action: the message at left, what to do next at right -->
  <section class="page-top">
    <div class="max-w-6xl mx-auto px-6 page-top-grid">
      <div>
        <h1>Your download should begin automatically.</h1>
        <p class="lede">If it does not, <a href={downloadUrl} class="link">download QualiLens.zip directly</a>.</p>
        <p class="text-sm text-text-muted mt-6">Already using QualiLens? <a href="/docs/whats-new" class="link">See what changed in the latest release</a>, then update from Settings.</p>
      </div>
      <div class="toc">
        <h2 class="toc-label font-sans text-[14px] font-normal tracking-normal">Next steps</h2>
        <ol class="space-y-3 text-[15px] text-text-secondary">
          <li class="flex gap-2"><span class="toc-n">1</span><span>Unzip the downloaded file and place the folder wherever you like.</span></li>
          <li class="flex gap-2"><span class="toc-n">2</span><span>Open a terminal in the QualiLens folder and run <code class="code-inline">./run.sh</code></span></li>
          <li class="flex gap-2"><span class="toc-n">3</span><span>Add an API key in Settings (Anthropic, OpenAI, Google, or Mistral).</span></li>
        </ol>
        <a href="/getting-started" class="inline-flex items-center gap-2 link link-strong mt-5">
          Full getting started guide
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <script define:vars={{ downloadUrl }}>
    // Start the download automatically after a short delay
    setTimeout(() => {
      window.location.href = downloadUrl;
    }, 500);
  </script>

</BaseLayout>
