---
import '../styles/global.css'

interface Props {
  title: string;
  description?: string;
}

const { title, description = "A local application for LLM-assisted qualitative data analysis. Your data stay on your computer." } = Astro.props;
const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(currentPath, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;
// Resolve the latest release version from GitHub at build time.
// First from the release page's redirect (/releases/latest -> /releases/tag/vX),
// which is ordinary web traffic and not subject to the API's unauthenticated
// rate limit — shared build runners exhaust that limit routinely, and a build
// that hit it would silently publish the stale fallback below. The API is the
// second attempt. The hardcoded value is the last resort; keep it at the
// current release when cutting one (devnotes/RELEASING.md).
let appVersion = '1.13.0';
const tagFrom = (s: string | null | undefined) => (s || '').replace(/^v/, '');
try {
  const page = await fetch('https://github.com/iconerr/qualilens/releases/latest',
                           { redirect: 'manual', headers: { 'User-Agent': 'qualilens-site' } });
  const m = (page.headers.get('location') || '').match(/\/releases\/tag\/([^/?#]+)/);
  const fromRedirect = m ? tagFrom(decodeURIComponent(m[1])) : '';
  if (fromRedirect) {
    appVersion = fromRedirect;
  } else {
    const res = await fetch(
      'https://api.github.com/repos/iconerr/qualilens/releases/latest',
      { headers: { 'Accept': 'application/vnd.github.v3+json',
                   'User-Agent': 'qualilens-site' } }
    );
    if (res.ok) {
      const tag = tagFrom((await res.json()).tag_name);
      if (tag) appVersion = tag;
    }
  }
} catch { /* network failure — use the fallback */ }

const navItems = [
  { href: '/features', label: 'Features' },
  { href: '/getting-started', label: 'Getting started' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/docs', label: 'Docs', section: true },
  { href: '/faq', label: 'FAQ' },
];
const isCurrent = (item: { href: string; section?: boolean }) =>
  item.section ? currentPath.startsWith(item.href)
               : currentPath === item.href || currentPath === item.href + '/';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "QualiLens",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "macOS (Apple silicon), Linux",
    "softwareVersion": appVersion,
    "description": "A local application for LLM-assisted qualitative data analysis. Runs five established qualitative methods with researcher-controlled checkpoints.",
    "url": "https://qualilens.org",
    "downloadUrl": "https://github.com/iconerr/qualilens/releases/latest/download/QualiLens.zip",
    "license": "https://www.apache.org/licenses/LICENSE-2.0",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "author": [
      { "@type": "Person", "name": "Ashita Aggarwal" },
      { "@type": "Person", "name": "Suraj Commuri" }
    ]
  })} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Serif:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />
  <title>{title}</title>
</head>
<body class="flex flex-col min-h-screen">

  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:bg-ink focus:text-white focus:text-sm focus:font-medium focus:rounded-md">Skip to content</a>

  <!-- Nav -->
  <nav class="sticky top-0 z-50 bg-paper border-b border-rule" aria-label="Main">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center">
      <a href="/" class="flex items-center gap-2.5 text-ink no-underline shrink-0">
        <img src="/favicon.svg" alt="" class="w-[26px] h-[26px]" />
        <span class="text-lg font-medium tracking-[-0.01em]">QualiLens</span>
      </a>

      <!-- Masthead: the sections beside the name, behind a hairline -->
      <div class="hidden md:flex items-center gap-5 lg:gap-[26px] h-[22px] ml-5 pl-5 lg:ml-7 lg:pl-7 border-l border-rule-strong text-[14px]">
        {navItems.map(item => (
          <a href={item.href} aria-current={isCurrent(item) ? 'page' : undefined}
             class:list={["whitespace-nowrap transition-colors", isCurrent(item) ? 'text-ink font-medium' : 'text-text-secondary hover:text-ink']}>{item.label}</a>
        ))}
      </div>

      <!-- Utilities, apart at the right -->
      <div class="hidden md:flex items-center gap-5 lg:gap-[26px] ml-auto pl-6 text-[14px]">
        <button id="search-btn-desktop" class="inline-flex items-baseline gap-1.5 whitespace-nowrap text-text-muted hover:text-ink transition-colors" title="Search the site and documentation">
          Search <kbd class="search-key hidden lg:inline font-mono text-[12px] text-text-muted">⌘K</kbd>
        </button>
        <a href="/download" class="inline-flex items-center gap-1.5 whitespace-nowrap font-medium text-ink hover:text-brand-500 transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0-5-5m5 5 5-5M5 20h14"/></svg>
          Get QualiLens
        </a>
      </div>

      <!-- Mobile buttons -->
      <div class="flex md:hidden items-center gap-1 ml-auto">
        <button id="search-btn-mobile" class="p-2 text-text-muted hover:text-ink transition-colors" aria-label="Search">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7.5"/><path stroke-linecap="round" d="m20.5 20.5-4-4"/></svg>
        </button>
        <button id="mobile-menu-btn" class="p-2 text-ink" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-rule bg-paper px-6 pb-5">
      {navItems.map(item => (
        <a href={item.href} aria-current={isCurrent(item) ? 'page' : undefined}
           class:list={["block py-3 text-[15px] border-b border-rule", isCurrent(item) ? 'text-ink font-medium' : 'text-text-secondary hover:text-ink']}>{item.label}</a>
      ))}
      <a href="/download" class="btn btn-ink btn-sm mt-4">Get QualiLens</a>
    </div>
  </nav>

  <!-- Main content -->
  <main id="main-content" class="flex-1">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="border-t border-rule">
    <div class="max-w-6xl mx-auto px-6 pt-12 pb-14 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-[5fr_2fr_2fr] gap-8 md:gap-12 text-[14.5px] text-text-muted">
      <!-- Brand -->
      <div class="sm:col-span-2 md:col-span-1">
        <a href="/" class="inline-flex items-center gap-2.5 text-ink">
          <img src="/favicon.svg" alt="" class="w-[26px] h-[26px]" />
          <span class="text-lg font-medium tracking-[-0.01em]">QualiLens</span>
        </a>
        <p class="mt-2.5 max-w-[30em]">LLM-assisted qualitative data analysis that runs entirely on your computer.</p>
        <p class="mt-3.5 text-[13.5px]">&copy; 2026 <a href="https://in.linkedin.com/in/drashita" target="_blank" rel="noopener" class="text-text-secondary underline decoration-rule-strong underline-offset-2 hover:text-brand-500">Ashita Aggarwal</a> and Suraj Commuri &middot; <span class="font-mono text-[0.92em]">v{appVersion}</span> &middot; Apache 2.0 License</p>
      </div>

      <!-- Product -->
      <div>
        <h4 class="text-sm font-semibold text-ink mb-3">Product</h4>
        <ul class="space-y-2">
          <li><a href="/features" class="text-text-secondary hover:text-brand-500 hover:underline">Features</a></li>
          <li><a href="/privacy" class="text-text-secondary hover:text-brand-500 hover:underline">Privacy</a></li>
          <li><a href="/getting-started" class="text-text-secondary hover:text-brand-500 hover:underline">Getting started</a></li>
          <li><a href="/docs" class="text-text-secondary hover:text-brand-500 hover:underline">Documentation</a></li>
          <li><a href="/faq" class="text-text-secondary hover:text-brand-500 hover:underline">FAQ</a></li>
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h4 class="text-sm font-semibold text-ink mb-3">Resources</h4>
        <ul class="space-y-2">
          <li><a href="https://github.com/iconerr/qualilens" target="_blank" rel="noopener" class="text-text-secondary hover:text-brand-500 hover:underline">GitHub</a></li>
          <li><a href="/docs/whats-new" class="text-text-secondary hover:text-brand-500 hover:underline">What's new</a></li>
          <li><a href="https://github.com/iconerr/qualilens/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener" class="text-text-secondary hover:text-brand-500 hover:underline">Contributing</a></li>
          <li><a href="/#cite" class="text-text-secondary hover:text-brand-500 hover:underline">How to cite</a></li>
        </ul>
      </div>
    </div>
  </footer>

  <!-- Search modal -->
  <div id="search-modal" class="hidden fixed inset-0 z-[100]" role="dialog" aria-modal="true" aria-label="Search">
    <div id="search-backdrop" class="absolute inset-0 bg-ink/40"></div>
    <div class="relative max-w-2xl mx-auto mt-[12vh] px-4">
      <div class="bg-white border border-rule rounded-lg shadow-xl overflow-hidden">
        <div class="flex items-center border-b border-rule px-4">
          <svg class="w-5 h-5 text-text-muted shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7.5"/><path stroke-linecap="round" d="m20.5 20.5-4-4"/></svg>
          <input id="search-input" type="text" placeholder="Search documentation..." class="w-full px-3 py-3 text-base outline-none bg-transparent text-ink placeholder:text-text-muted" autocomplete="off" />
          <kbd class="hidden sm:inline-block text-xs text-text-muted border border-rule rounded px-1.5 py-0.5 font-mono">Esc</kbd>
        </div>
        <div id="search-results" class="max-h-[60vh] overflow-y-auto"></div>
      </div>
    </div>
  </div>

  <!-- Screenshot overlay: any link marked data-figure opens its image here, over the page.
       Closes with Esc, a click outside the image, or Close. Without JavaScript the link opens the image file. -->
  <dialog class="figure-dialog" id="figure-dialog" aria-label="Screenshot at full size">
    <div class="fd-inner">
      <button type="button" class="fd-close" data-close>Close <kbd>Esc</kbd></button>
      <img alt="" />
    </div>
  </dialog>

  <script is:inline>
    // The search shortcut is ⌘K on a Mac and Ctrl K elsewhere (the handler below accepts both)
    if (!/Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent)) {
      document.querySelectorAll('.search-key').forEach(function(k) { k.textContent = 'Ctrl K'; });
    }

    // Mobile menu
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    btn?.addEventListener('click', () => {
      menu?.classList.toggle('hidden');
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
    });

    // Search
    var searchIndex = null;
    var modal = document.getElementById('search-modal');
    var searchInput = document.getElementById('search-input');
    var searchResults = document.getElementById('search-results');

    function openSearch() {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      searchInput.focus();
      if (!searchIndex) {
        fetch('/search-index.json')
          .then(function(r) { return r.json(); })
          .then(function(data) { searchIndex = data; doSearch(searchInput.value); })
          .catch(function() { searchIndex = []; });
      }
    }

    function closeSearch() {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }

    function getSnippet(content, query, len) {
      var lower = content.toLowerCase();
      var idx = lower.indexOf(query.toLowerCase());
      if (idx === -1) return content.slice(0, len) + '...';
      var start = Math.max(0, idx - 40);
      var end = Math.min(content.length, idx + query.length + len - 40);
      var snippet = (start > 0 ? '...' : '') + content.slice(start, end) + (end < content.length ? '...' : '');
      return snippet;
    }

    function highlightMatch(text, query) {
      if (!query) return text;
      var re = new RegExp('(' + query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
      return text.replace(re, '<mark class="bg-highlight text-ink px-0.5 rounded-sm">$1</mark>');
    }

    function doSearch(query) {
      if (!searchResults) return;
      if (!query || query.length < 2) {
        searchResults.innerHTML = '<p class="px-4 py-8 text-center text-sm text-text-muted">Type at least 2 characters to search</p>';
        return;
      }
      if (!searchIndex) {
        searchResults.innerHTML = '<p class="px-4 py-8 text-center text-sm text-text-muted">Loading...</p>';
        return;
      }
      var q = query.toLowerCase();
      var matches = searchIndex.filter(function(page) {
        return page.title.toLowerCase().indexOf(q) !== -1 || page.content.toLowerCase().indexOf(q) !== -1;
      });
      // Rank: title matches first (shorter = more specific), then by frequency
      var qEsc = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      var qRe = new RegExp(qEsc, 'gi');
      matches.sort(function(a, b) {
        var aInTitle = a.title.toLowerCase().indexOf(q) !== -1;
        var bInTitle = b.title.toLowerCase().indexOf(q) !== -1;
        if (aInTitle !== bInTitle) return aInTitle ? -1 : 1;
        if (aInTitle && bInTitle) return a.title.length - b.title.length;
        var aCount = (a.content.match(qRe) || []).length;
        var bCount = (b.content.match(qRe) || []).length;
        return bCount - aCount;
      });
      if (matches.length === 0) {
        searchResults.innerHTML = '<p class="px-4 py-8 text-center text-sm text-text-muted">No results for "' + query.replace(/</g, '&lt;') + '"</p>';
        return;
      }
      var html = '';
      matches.forEach(function(page) {
        var snippet = getSnippet(page.content, query, 120);
        html += '<a href="' + page.url + '" class="block px-4 py-3 border-b border-rule hover:bg-panel transition-colors">';
        html += '<div class="text-sm font-medium text-ink">' + highlightMatch(page.title.replace(/</g, '&lt;'), query);
        if (page.page) html += ' <span class="font-normal text-text-muted">— ' + page.page.replace(/</g, '&lt;') + '</span>';
        html += '</div>';
        html += '<div class="text-xs text-text-muted mt-1 leading-relaxed">' + highlightMatch(snippet.replace(/</g, '&lt;'), query) + '</div>';
        html += '</a>';
      });
      searchResults.innerHTML = html;
    }

    document.getElementById('search-btn-desktop')?.addEventListener('click', openSearch);
    document.getElementById('search-btn-mobile')?.addEventListener('click', openSearch);
    document.getElementById('search-backdrop')?.addEventListener('click', closeSearch);
    searchInput?.addEventListener('input', function() { doSearch(this.value); });

    document.addEventListener('keydown', function(e) {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        modal.classList.contains('hidden') ? openSearch() : closeSearch();
      }
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeSearch();
      }
    });

    // Show initial state when modal opens
    if (searchResults) {
      searchResults.innerHTML = '<p class="px-4 py-8 text-center text-sm text-text-muted">Type at least 2 characters to search</p>';
    }

    // Screenshot overlay. data-w / data-h give the full image's size in CSS pixels
    // (a double-resolution file is shown at half its pixel width); otherwise the
    // inline image's width and height are used.
    var figureDialog = document.getElementById('figure-dialog');
    if (figureDialog && typeof figureDialog.showModal === 'function') {
      var fdInner = figureDialog.querySelector('.fd-inner');
      var fdImg = figureDialog.querySelector('img');
      document.querySelectorAll('a[data-figure]').forEach(function(a) {
        a.addEventListener('click', function(e) {
          if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          e.preventDefault();
          var inline = a.querySelector('img');
          var w = +(a.getAttribute('data-w') || (inline && inline.getAttribute('width')) || 1400);
          var h = +(a.getAttribute('data-h') || (inline && inline.getAttribute('height')) || 900);
          fdImg.width = w; fdImg.height = h;
          fdImg.style.setProperty('--fd-w', w + 'px');
          fdImg.alt = inline ? inline.alt : '';
          fdImg.src = a.getAttribute('href');
          figureDialog.setAttribute('aria-label', (inline && inline.alt) || 'Screenshot at full size');
          figureDialog.showModal();
          fdInner.scrollTo(0, 0);
        });
      });
      figureDialog.addEventListener('click', function(e) {
        var t = e.target;
        if (t === figureDialog || t === fdInner || (t.closest && t.closest('[data-close]'))) figureDialog.close();
      });
    }
  </script>
</body>
</html>
