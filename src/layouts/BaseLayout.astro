---
import '../styles/global.css'

interface Props {
  title: string;
  description?: string;
}

const { title, description = "A local application for LLM-assisted qualitative data analysis. Your data stay on your computer." } = Astro.props;
const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(currentPath, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;
// Resolve the latest release version from GitHub at build time.
// First from the release page's redirect (/releases/latest -> /releases/tag/vX),
// which is ordinary web traffic and not subject to the API's unauthenticated
// rate limit — shared build runners exhaust that limit routinely, and a build
// that hit it would silently publish the stale fallback below. The API is the
// second attempt. The hardcoded value is the last resort; keep it at the
// current release when cutting one (devnotes/RELEASING.md).
let appVersion = '1.7.0';
const tagFrom = (s: string | null | undefined) => (s || '').replace(/^v/, '');
try {
  const page = await fetch('https://github.com/iconerr/qualilens/releases/latest',
                           { redirect: 'manual', headers: { 'User-Agent': 'qualilens-site' } });
  const m = (page.headers.get('location') || '').match(/\/releases\/tag\/([^/?#]+)/);
  const fromRedirect = m ? tagFrom(decodeURIComponent(m[1])) : '';
  if (fromRedirect) {
    appVersion = fromRedirect;
  } else {
    const res = await fetch(
      'https://api.github.com/repos/iconerr/qualilens/releases/latest',
      { headers: { 'Accept': 'application/vnd.github.v3+json',
                   'User-Agent': 'qualilens-site' } }
    );
    if (res.ok) {
      const tag = tagFrom((await res.json()).tag_name);
      if (tag) appVersion = tag;
    }
  }
} catch { /* network failure — use the fallback */ }
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "QualiLens",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "macOS, Linux",
    "softwareVersion": appVersion,
    "description": "A local application for LLM-assisted qualitative data analysis. Runs five established qualitative methods with researcher-controlled checkpoints.",
    "url": "https://qualilens.org",
    "downloadUrl": "https://github.com/iconerr/qualilens/releases/latest/download/QualiLens.zip",
    "license": "https://www.apache.org/licenses/LICENSE-2.0",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "author": [
      { "@type": "Person", "name": "Ashita Aggarwal" },
      { "@type": "Person", "name": "Suraj Commuri" }
    ]
  })} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <title>{title}</title>
</head>
<body class="flex flex-col min-h-screen">

  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:bg-brand-600 focus:text-white focus:text-sm focus:font-semibold">Skip to content</a>

  <!-- Nav -->
  <nav class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-border">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5 group">
        <img src="/favicon.svg" alt="" class="w-8 h-8" />
        <span class="text-xl font-bold text-text-primary">QualiLens</span>
      </a>

      <!-- Desktop links -->
      <div class="hidden md:flex items-center gap-8">
        <a href="/features" class:list={["text-sm font-medium transition-colors hover:text-brand-500", currentPath === '/features' || currentPath === '/features/' ? 'text-brand-500' : 'text-text-secondary']}>Features</a>
        <a href="/getting-started" class:list={["text-sm font-medium transition-colors hover:text-brand-500", currentPath === '/getting-started' || currentPath === '/getting-started/' ? 'text-brand-500' : 'text-text-secondary']}>Getting Started</a>
        <a href="/privacy" class:list={["text-sm font-medium transition-colors hover:text-brand-500", currentPath === '/privacy' || currentPath === '/privacy/' ? 'text-brand-500' : 'text-text-secondary']}>Privacy</a>
        <a href="/docs" class:list={["text-sm font-medium transition-colors hover:text-brand-500", currentPath.startsWith('/docs') ? 'text-brand-500' : 'text-text-secondary']}>Docs</a>
        <a href="/faq" class:list={["text-sm font-medium transition-colors hover:text-brand-500", currentPath === '/faq' || currentPath === '/faq/' ? 'text-brand-500' : 'text-text-secondary']}>FAQ</a>
        <button id="search-btn-desktop" class="p-2 text-text-secondary hover:text-brand-500 transition-colors" aria-label="Search" title="Search (⌘K)">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/></svg>
        </button>
        <a href="/download" class="inline-flex items-center gap-2 px-4 py-2 bg-brand-600 text-white text-sm font-semibold hover:bg-brand-500 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 15V3" /></svg>
          Get QualiLens
        </a>
      </div>

      <!-- Mobile buttons -->
      <div class="flex md:hidden items-center gap-1">
        <button id="search-btn-mobile" class="p-2 text-text-secondary hover:text-brand-500 transition-colors" aria-label="Search">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/></svg>
        </button>
        <button id="mobile-menu-btn" class="p-2 text-text-secondary hover:text-brand-500" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-border bg-white px-6 pb-4">
      <a href="/features" class="block py-3 text-sm font-medium text-text-secondary hover:text-brand-500">Features</a>
      <a href="/getting-started" class="block py-3 text-sm font-medium text-text-secondary hover:text-brand-500">Getting Started</a>
      <a href="/privacy" class="block py-3 text-sm font-medium text-text-secondary hover:text-brand-500">Privacy</a>
      <a href="/docs" class="block py-3 text-sm font-medium text-text-secondary hover:text-brand-500">Docs</a>
      <a href="/faq" class="block py-3 text-sm font-medium text-text-secondary hover:text-brand-500">FAQ</a>
      <a href="/download" class="inline-flex items-center gap-2 mt-2 px-4 py-2 bg-brand-600 text-white text-sm font-semibold">
        Get QualiLens
      </a>
    </div>
  </nav>

  <!-- Main content -->
  <main id="main-content" class="flex-1">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="bg-text-primary text-white/70">
    <div class="max-w-6xl mx-auto px-6 py-12">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <!-- Brand -->
        <div class="md:col-span-1">
          <div class="flex items-center gap-2.5 mb-4">
            <img src="/favicon.svg" alt="" class="w-7 h-7" />
            <span class="text-lg font-bold text-white">QualiLens</span>
          </div>
          <p class="text-sm leading-relaxed mb-4">LLM-assisted qualitative data analysis that runs entirely on your computer.</p>
          <p class="text-xs text-white/40">&copy; 2026 <a href="https://in.linkedin.com/in/drashita" target="_blank" rel="noopener" class="underline decoration-white/30 hover:text-white/60 hover:decoration-white/50 transition-colors">Ashita Aggarwal</a> and Suraj Commuri &middot; v{appVersion}</p>
        </div>

        <!-- Product -->
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-wider text-white/50 mb-4">Product</h4>
          <ul class="space-y-2.5 text-sm">
            <li><a href="/features" class="hover:text-white transition-colors">Features</a></li>
            <li><a href="/privacy" class="hover:text-white transition-colors">Privacy</a></li>
            <li><a href="/getting-started" class="hover:text-white transition-colors">Getting Started</a></li>
            <li><a href="/docs" class="hover:text-white transition-colors">Documentation</a></li>
            <li><a href="/faq" class="hover:text-white transition-colors">FAQ</a></li>
          </ul>
        </div>

        <!-- Resources -->
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-wider text-white/50 mb-4">Resources</h4>
          <ul class="space-y-2.5 text-sm">
            <li><a href="https://github.com/iconerr/qualilens" target="_blank" rel="noopener" class="hover:text-white transition-colors">GitHub</a></li>
            <li><a href="https://github.com/iconerr/qualilens/blob/main/CHANGELOG.md" target="_blank" rel="noopener" class="hover:text-white transition-colors">Changelog</a></li>
            <li><a href="https://github.com/iconerr/qualilens/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener" class="hover:text-white transition-colors">Contributing</a></li>
          </ul>
        </div>

        <!-- Citation -->
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-wider text-white/50 mb-4">Cite QualiLens</h4>
          <p class="text-sm leading-relaxed mb-3">Aggarwal, A., &amp; Commuri, S. (2026). <em>QualiLens</em> [Computer software]. Zenodo. <a href="https://doi.org/10.5281/zenodo.22191913" target="_blank" rel="noopener" class="text-brand-400 hover:text-white transition-colors">doi:10.5281/zenodo.22191913</a></p>
          <p class="text-xs text-white/40">Apache 2.0 License</p>
        </div>
      </div>

    </div>
  </footer>

  <!-- Search modal -->
  <div id="search-modal" class="hidden fixed inset-0 z-[100]" role="dialog" aria-modal="true" aria-label="Search">
    <div id="search-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
    <div class="relative max-w-2xl mx-auto mt-[12vh] px-4">
      <div class="bg-white border border-border shadow-xl overflow-hidden">
        <div class="flex items-center border-b border-border px-4">
          <svg class="w-5 h-5 text-text-muted shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/></svg>
          <input id="search-input" type="text" placeholder="Search documentation..." class="w-full px-3 py-3 text-base outline-none bg-transparent text-text-primary placeholder:text-text-muted" autocomplete="off" />
          <kbd class="hidden sm:inline-block text-xs text-text-muted border border-border px-1.5 py-0.5 font-mono">Esc</kbd>
        </div>
        <div id="search-results" class="max-h-[60vh] overflow-y-auto"></div>
      </div>
    </div>
  </div>

  <script is:inline>
    // Mobile menu
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    btn?.addEventListener('click', () => {
      menu?.classList.toggle('hidden');
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
    });

    // Search
    var searchIndex = null;
    var modal = document.getElementById('search-modal');
    var searchInput = document.getElementById('search-input');
    var searchResults = document.getElementById('search-results');

    function openSearch() {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      searchInput.focus();
      if (!searchIndex) {
        fetch('/search-index.json')
          .then(function(r) { return r.json(); })
          .then(function(data) { searchIndex = data; })
          .catch(function() { searchIndex = []; });
      }
    }

    function closeSearch() {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }

    function getSnippet(content, query, len) {
      var lower = content.toLowerCase();
      var idx = lower.indexOf(query.toLowerCase());
      if (idx === -1) return content.slice(0, len) + '...';
      var start = Math.max(0, idx - 40);
      var end = Math.min(content.length, idx + query.length + len - 40);
      var snippet = (start > 0 ? '...' : '') + content.slice(start, end) + (end < content.length ? '...' : '');
      return snippet;
    }

    function highlightMatch(text, query) {
      if (!query) return text;
      var re = new RegExp('(' + query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
      return text.replace(re, '<mark class="bg-brand-100 text-brand-600 px-0.5">$1</mark>');
    }

    function doSearch(query) {
      if (!searchResults) return;
      if (!query || query.length < 2) {
        searchResults.innerHTML = '<p class="px-4 py-8 text-center text-sm text-text-muted">Type at least 2 characters to search</p>';
        return;
      }
      if (!searchIndex) {
        searchResults.innerHTML = '<p class="px-4 py-8 text-center text-sm text-text-muted">Loading...</p>';
        return;
      }
      var q = query.toLowerCase();
      var matches = searchIndex.filter(function(page) {
        return page.title.toLowerCase().indexOf(q) !== -1 || page.content.toLowerCase().indexOf(q) !== -1;
      });
      // Rank: title matches first (shorter = more specific), then by frequency
      var qEsc = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      var qRe = new RegExp(qEsc, 'gi');
      matches.sort(function(a, b) {
        var aInTitle = a.title.toLowerCase().indexOf(q) !== -1;
        var bInTitle = b.title.toLowerCase().indexOf(q) !== -1;
        if (aInTitle !== bInTitle) return aInTitle ? -1 : 1;
        if (aInTitle && bInTitle) return a.title.length - b.title.length;
        var aCount = (a.content.match(qRe) || []).length;
        var bCount = (b.content.match(qRe) || []).length;
        return bCount - aCount;
      });
      if (matches.length === 0) {
        searchResults.innerHTML = '<p class="px-4 py-8 text-center text-sm text-text-muted">No results for "' + query.replace(/</g, '&lt;') + '"</p>';
        return;
      }
      var html = '';
      matches.forEach(function(page) {
        var snippet = getSnippet(page.content, query, 120);
        html += '<a href="' + page.url + '" class="block px-4 py-3 border-b border-border hover:bg-surface transition-colors">';
        html += '<div class="text-sm font-medium text-brand-600">' + highlightMatch(page.title.replace(/</g, '&lt;'), query);
        if (page.page) html += ' <span class="font-normal text-text-muted">— ' + page.page.replace(/</g, '&lt;') + '</span>';
        html += '</div>';
        html += '<div class="text-xs text-text-muted mt-1 leading-relaxed">' + highlightMatch(snippet.replace(/</g, '&lt;'), query) + '</div>';
        html += '</a>';
      });
      searchResults.innerHTML = html;
    }

    document.getElementById('search-btn-desktop')?.addEventListener('click', openSearch);
    document.getElementById('search-btn-mobile')?.addEventListener('click', openSearch);
    document.getElementById('search-backdrop')?.addEventListener('click', closeSearch);
    searchInput?.addEventListener('input', function() { doSearch(this.value); });

    document.addEventListener('keydown', function(e) {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        modal.classList.contains('hidden') ? openSearch() : closeSearch();
      }
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeSearch();
      }
    });

    // Show initial state when modal opens
    if (searchResults) {
      searchResults.innerHTML = '<p class="px-4 py-8 text-center text-sm text-text-muted">Type at least 2 characters to search</p>';
    }
  </script>
</body>
</html>
