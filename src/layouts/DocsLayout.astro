---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  order?: number;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;

const sidebarGroups = [
  {
    label: "Getting started",
    items: [
      { title: "Getting Started", href: "/docs/getting-started" },
      { title: "The Wizard", href: "/docs/the-wizard" },
      { title: "Choosing a Method", href: "/docs/choosing-a-method" },
    ]
  },
  {
    label: "Methods",
    items: [
      { title: "Grounded Theory", href: "/docs/grounded-theory" },
      { title: "Thematic Analysis", href: "/docs/thematic-analysis" },
      { title: "Content Analysis", href: "/docs/content-analysis" },
      { title: "Framework Analysis", href: "/docs/framework-analysis" },
      { title: "Literature Synthesis", href: "/docs/literature-synthesis" },
    ]
  },
  {
    label: "Using the app",
    items: [
      { title: "Checkpoints", href: "/docs/checkpoints" },
      { title: "Coded-Source Reader", href: "/docs/coded-source-reader" },
      { title: "Runs and Recovery", href: "/docs/runs-and-recovery" },
      { title: "Reports", href: "/docs/reports" },
    ]
  },
  {
    label: "Reference",
    items: [
      { title: "Troubleshooting", href: "/docs/troubleshooting" },
      { title: "Data and Privacy", href: "/docs/data-and-privacy" },
      { title: "Walkthrough", href: "/docs/walkthrough" },
      { title: "Glossary", href: "/docs/glossary" },
    ]
  },
];

function isActive(href: string): boolean {
  const norm = currentPath.replace(/\/$/, '');
  return norm === href || norm === href + '/';
}
---

<BaseLayout title={`${title} — QualiLens Docs`} description={description || `QualiLens documentation: ${title}`}>

  <div class="max-w-7xl mx-auto flex">

    <!-- Sidebar (desktop) -->
    <aside class="hidden lg:block w-64 shrink-0 border-r border-border bg-white sticky top-16 h-[calc(100vh-4rem)] overflow-y-auto">
      <nav class="py-6 px-5" aria-label="Documentation">
        <a href="/docs" class:list={["block text-sm font-semibold mb-5 transition-colors", isActive('/docs') ? 'text-brand-600' : 'text-text-primary hover:text-brand-500']}>
          Documentation
        </a>
        {sidebarGroups.map(group => (
          <div class="mb-5">
            <h4 class="text-xs font-semibold uppercase tracking-wider text-text-muted mb-2">{group.label}</h4>
            <ul class="space-y-0.5">
              {group.items.map(item => (
                <li>
                  <a href={item.href} class:list={[
                    "block py-1.5 px-2 text-sm transition-colors -mx-2",
                    isActive(item.href)
                      ? "text-brand-600 font-medium bg-brand-50"
                      : "text-text-secondary hover:text-brand-500 hover:bg-surface"
                  ]}>
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </aside>

    <!-- Mobile nav toggle + drawer -->
    <div class="lg:hidden fixed bottom-4 right-4 z-40">
      <button id="docs-nav-btn" class="flex items-center gap-2 px-4 py-2.5 bg-brand-600 text-white text-sm font-semibold shadow-lg" aria-label="Open docs navigation" aria-expanded="false" aria-controls="docs-nav-drawer">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
        Chapters
      </button>
    </div>

    <div id="docs-nav-drawer" class="hidden fixed inset-0 z-50 lg:hidden">
      <div class="absolute inset-0 bg-black/40" id="docs-nav-backdrop"></div>
      <aside class="absolute right-0 top-0 bottom-0 w-72 bg-white overflow-y-auto shadow-xl">
        <div class="flex items-center justify-between px-5 py-4 border-b border-border">
          <span class="text-sm font-semibold">Chapters</span>
          <button id="docs-nav-close" class="p-1 text-text-muted hover:text-text-primary" aria-label="Close">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <nav class="py-4 px-5" aria-label="Documentation">
          <a href="/docs" class:list={["block text-sm font-semibold mb-4 transition-colors", isActive('/docs') ? 'text-brand-600' : 'text-text-primary hover:text-brand-500']}>
            Documentation
          </a>
          {sidebarGroups.map(group => (
            <div class="mb-4">
              <h4 class="text-xs font-semibold uppercase tracking-wider text-text-muted mb-2">{group.label}</h4>
              <ul class="space-y-0.5">
                {group.items.map(item => (
                  <li>
                    <a href={item.href} class:list={[
                      "block py-1.5 px-2 text-sm transition-colors -mx-2",
                      isActive(item.href)
                        ? "text-brand-600 font-medium bg-brand-50"
                        : "text-text-secondary hover:text-brand-500 hover:bg-surface"
                    ]}>
                      {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </aside>
    </div>

    <!-- Main content -->
    <main class="flex-1 min-w-0 py-10 px-6 lg:px-12">
      <article class="max-w-3xl docs-prose">
        <slot />
      </article>
    </main>

  </div>

  <style>
    .docs-prose :global(h1) {
      font-size: 1.875rem;
      font-weight: 700;
      line-height: 1.3;
      margin-bottom: 1.5rem;
      color: var(--color-text-primary);
    }
    .docs-prose :global(h2) {
      font-size: 1.25rem;
      font-weight: 700;
      line-height: 1.4;
      margin-top: 2.5rem;
      margin-bottom: 0.75rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--color-border);
      color: var(--color-text-primary);
    }
    .docs-prose :global(h3) {
      font-size: 1.05rem;
      font-weight: 600;
      line-height: 1.4;
      margin-top: 2rem;
      margin-bottom: 0.5rem;
      color: var(--color-text-primary);
    }
    .docs-prose :global(p) {
      margin-bottom: 1rem;
      line-height: 1.75;
      color: var(--color-text-secondary);
    }
    .docs-prose :global(a) {
      color: var(--color-brand-500);
      text-decoration: none;
    }
    .docs-prose :global(a:hover) {
      text-decoration: underline;
    }
    .docs-prose :global(strong) {
      font-weight: 600;
      color: var(--color-text-primary);
    }
    .docs-prose :global(em) {
      font-style: italic;
    }
    .docs-prose :global(code) {
      font-family: var(--font-mono);
      font-size: 0.875em;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      padding: 0.125rem 0.375rem;
    }
    .docs-prose :global(pre) {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      line-height: 1.6;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      padding: 1rem 1.25rem;
      margin-bottom: 1.25rem;
      overflow-x: auto;
    }
    .docs-prose :global(pre code) {
      background: none;
      border: none;
      padding: 0;
      font-size: inherit;
    }
    .docs-prose :global(blockquote) {
      border-left: 3px solid var(--color-brand-400);
      padding-left: 1rem;
      margin: 1.25rem 0;
      color: var(--color-text-secondary);
      font-style: italic;
    }
    .docs-prose :global(ul) {
      list-style-type: disc;
      padding-left: 1.5rem;
      margin-bottom: 1rem;
    }
    .docs-prose :global(ol) {
      list-style-type: decimal;
      padding-left: 1.5rem;
      margin-bottom: 1rem;
    }
    .docs-prose :global(li) {
      margin-bottom: 0.375rem;
      line-height: 1.7;
      color: var(--color-text-secondary);
    }
    .docs-prose :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 1.25rem;
      font-size: 0.875rem;
    }
    .docs-prose :global(th) {
      text-align: left;
      font-weight: 600;
      padding: 0.5rem 0.75rem;
      border-bottom: 2px solid var(--color-border);
      color: var(--color-text-primary);
      background: var(--color-surface);
    }
    .docs-prose :global(td) {
      padding: 0.5rem 0.75rem;
      border-bottom: 1px solid var(--color-border);
      color: var(--color-text-secondary);
      vertical-align: top;
    }
    .docs-prose :global(hr) {
      border: none;
      border-top: 1px solid var(--color-border);
      margin: 2rem 0;
    }
    .docs-prose :global(table) {
      display: block;
      overflow-x: auto;
    }
  </style>

  <script>
    const btn = document.getElementById('docs-nav-btn');
    const drawer = document.getElementById('docs-nav-drawer');
    const backdrop = document.getElementById('docs-nav-backdrop');
    const closeBtn = document.getElementById('docs-nav-close');

    function openDrawer() {
      drawer?.classList.remove('hidden');
      btn?.setAttribute('aria-expanded', 'true');
    }
    function closeDrawer() {
      drawer?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    }

    btn?.addEventListener('click', openDrawer);
    backdrop?.addEventListener('click', closeDrawer);
    closeBtn?.addEventListener('click', closeDrawer);
  </script>

</BaseLayout>
