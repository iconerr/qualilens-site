---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  order?: number;
}

const { title, description } = Astro.props.frontmatter || Astro.props;
const currentPath = Astro.url.pathname;

const sidebarGroups = [
  {
    label: "Getting started",
    items: [
      { title: "Getting Started", href: "/docs/getting-started" },
      { title: "The Wizard", href: "/docs/the-wizard" },
      { title: "Choosing a Method", href: "/docs/choosing-a-method" },
    ]
  },
  {
    label: "Methods",
    items: [
      { title: "Grounded Theory", href: "/docs/grounded-theory" },
      { title: "Thematic Analysis", href: "/docs/thematic-analysis" },
      { title: "Content Analysis", href: "/docs/content-analysis" },
      { title: "Framework Analysis", href: "/docs/framework-analysis" },
      { title: "Literature Synthesis", href: "/docs/literature-synthesis" },
    ]
  },
  {
    label: "Using the app",
    items: [
      { title: "Checkpoints", href: "/docs/checkpoints" },
      { title: "Coded-Source Reader", href: "/docs/coded-source-reader" },
      { title: "Runs and Recovery", href: "/docs/runs-and-recovery" },
      { title: "Reports", href: "/docs/reports" },
    ]
  },
  {
    label: "Reference",
    items: [
      { title: "Troubleshooting", href: "/docs/troubleshooting" },
      { title: "Data and Privacy", href: "/docs/data-and-privacy" },
      { title: "Walkthrough", href: "/docs/walkthrough" },
      { title: "Glossary", href: "/docs/glossary" },
      { title: "What's New", href: "/docs/whats-new" },
    ]
  },
];

function isActive(href: string): boolean {
  const norm = currentPath.replace(/\/$/, '');
  return norm === href || norm === href + '/';
}
---

<BaseLayout title={`${title} — QualiLens Docs`} description={description || `QualiLens documentation: ${title}`}>

  <!-- Same container as the header, so the sidebar's text lines up under the logo -->
  <div class="max-w-6xl mx-auto px-6 flex">

    <!-- Sidebar (desktop) -->
    <aside class="hidden lg:block w-60 shrink-0 -ml-2 border-r border-rule bg-paper sticky top-16 h-[calc(100vh-4rem)] overflow-y-auto">
      <nav class="py-6 pl-2 pr-5" aria-label="Documentation">
        <a href="/docs" class:list={["block text-sm font-semibold mb-5 transition-colors", isActive('/docs') ? 'text-ink' : 'text-ink hover:text-brand-500']}>
          Documentation
        </a>
        {sidebarGroups.map(group => (
          <div class="mb-5">
            <h4 class="text-[13px] font-medium text-text-muted mb-1.5">{group.label}</h4>
            <ul class="space-y-0.5">
              {group.items.map(item => (
                <li>
                  <a href={item.href} class:list={[
                    "block py-1.5 px-2 text-[14.5px] rounded transition-colors -mx-2",
                    isActive(item.href)
                      ? "text-ink font-medium bg-panel"
                      : "text-text-secondary hover:text-ink hover:bg-panel"
                  ]}>
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </aside>

    <!-- Mobile nav toggle + drawer -->
    <div class="lg:hidden fixed bottom-4 right-4 z-40">
      <button id="docs-nav-btn" class="flex items-center gap-2 px-4 py-2.5 bg-ink text-white text-sm font-medium rounded-md shadow-lg" aria-label="Open docs navigation" aria-expanded="false" aria-controls="docs-nav-drawer">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
        Chapters
      </button>
    </div>

    <div id="docs-nav-drawer" class="hidden fixed inset-0 z-50 lg:hidden">
      <div class="absolute inset-0 bg-ink/40" id="docs-nav-backdrop"></div>
      <aside class="absolute right-0 top-0 bottom-0 w-72 bg-paper overflow-y-auto shadow-xl">
        <div class="flex items-center justify-between px-5 py-4 border-b border-rule">
          <span class="text-sm font-semibold">Chapters</span>
          <button id="docs-nav-close" class="p-1 text-text-muted hover:text-text-primary" aria-label="Close">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <nav class="py-4 px-5" aria-label="Documentation">
          <a href="/docs" class:list={["block text-sm font-semibold mb-4 transition-colors", isActive('/docs') ? 'text-ink' : 'text-ink hover:text-brand-500']}>
            Documentation
          </a>
          {sidebarGroups.map(group => (
            <div class="mb-4">
              <h4 class="text-[13px] font-medium text-text-muted mb-1.5">{group.label}</h4>
              <ul class="space-y-0.5">
                {group.items.map(item => (
                  <li>
                    <a href={item.href} class:list={[
                      "block py-1.5 px-2 text-[14.5px] rounded transition-colors -mx-2",
                      isActive(item.href)
                        ? "text-ink font-medium bg-panel"
                        : "text-text-secondary hover:text-ink hover:bg-panel"
                    ]}>
                      {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </aside>
    </div>

    <!-- Content (BaseLayout already provides <main>) -->
    <div class="flex-1 min-w-0 py-12 lg:pl-12">
      <article class="max-w-3xl docs-prose">
        <slot />
      </article>
    </div>

  </div>

  <style>
    .docs-prose :global(h1) {
      font-family: var(--font-serif);
      font-size: 2.25rem;
      font-weight: 500;
      line-height: 1.2;
      letter-spacing: -0.01em;
      margin-bottom: 1.5rem;
      color: var(--color-ink);
    }
    .docs-prose :global(h2) {
      font-family: var(--font-serif);
      font-size: 1.5rem;
      font-weight: 500;
      line-height: 1.3;
      margin-top: 2.75rem;
      margin-bottom: 0.75rem;
      color: var(--color-ink);
    }
    .docs-prose :global(h3) {
      font-size: 1.05rem;
      font-weight: 600;
      line-height: 1.4;
      margin-top: 2rem;
      margin-bottom: 0.5rem;
      color: var(--color-text-primary);
    }
    .docs-prose :global(p) {
      margin-bottom: 1rem;
      line-height: 1.75;
      color: var(--color-text-secondary);
    }
    .docs-prose :global(a) {
      color: var(--color-brand-500);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
      text-decoration-color: color-mix(in srgb, var(--color-brand-500) 40%, transparent);
    }
    .docs-prose :global(a:hover) {
      color: var(--color-brand-600);
      text-decoration-color: currentColor;
    }
    .docs-prose :global(strong) {
      font-weight: 600;
      color: var(--color-text-primary);
    }
    .docs-prose :global(em) {
      font-style: italic;
    }
    .docs-prose :global(code) {
      font-family: var(--font-mono);
      font-size: 0.875em;
      background: var(--color-panel);
      border: 1px solid var(--color-rule);
      border-radius: 3px;
      padding: 0.0625rem 0.3125rem;
    }
    .docs-prose :global(pre) {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      line-height: 1.6;
      background: #fff;
      border: 1px solid var(--color-rule);
      border-radius: 6px;
      padding: 1rem 1.25rem;
      margin-bottom: 1.25rem;
      overflow-x: auto;
    }
    .docs-prose :global(pre code) {
      background: none;
      border: none;
      padding: 0;
      font-size: inherit;
    }
    .docs-prose :global(blockquote) {
      border-left: 2px solid var(--color-rule-strong);
      padding-left: 1rem;
      margin: 1.25rem 0;
      color: var(--color-text-secondary);
      font-style: italic;
    }
    .docs-prose :global(ul) {
      list-style-type: disc;
      padding-left: 1.5rem;
      margin-bottom: 1rem;
    }
    .docs-prose :global(ol) {
      list-style-type: decimal;
      padding-left: 1.5rem;
      margin-bottom: 1rem;
    }
    .docs-prose :global(li) {
      margin-bottom: 0.375rem;
      line-height: 1.7;
      color: var(--color-text-secondary);
    }
    .docs-prose :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 1.25rem;
      font-size: 0.875rem;
    }
    .docs-prose :global(th) {
      text-align: left;
      font-weight: 600;
      padding: 0.5rem 0.75rem;
      border-bottom: 1px solid var(--color-rule-strong);
      color: var(--color-text-primary);
      background: var(--color-surface);
    }
    .docs-prose :global(td) {
      padding: 0.5rem 0.75rem;
      border-bottom: 1px solid var(--color-border);
      color: var(--color-text-secondary);
      vertical-align: top;
    }
    .docs-prose :global(hr) {
      border: none;
      border-top: 1px solid var(--color-border);
      margin: 2rem 0;
    }
    .docs-prose :global(pre .docs-copy-btn) {
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
      padding: 0.375rem;
      color: var(--color-text-muted);
      opacity: 0;
      transition: opacity 0.15s, color 0.15s;
      cursor: pointer;
      background: none;
      border: none;
    }
    .docs-prose :global(pre:hover .docs-copy-btn) {
      opacity: 1;
    }
    .docs-prose :global(pre .docs-copy-btn:hover) {
      color: var(--color-brand-600);
    }
    .docs-prose :global(table) {
      display: block;
      overflow-x: auto;
    }
    .docs-prose :global(td .docs-table-copy-btn) {
      display: inline-flex;
      padding: 0.125rem;
      margin-left: 0.25rem;
      color: var(--color-text-muted);
      opacity: 0;
      transition: opacity 0.15s, color 0.15s;
      cursor: pointer;
      background: none;
      border: none;
      vertical-align: middle;
    }
    .docs-prose :global(td:hover .docs-table-copy-btn) {
      opacity: 0.6;
    }
    .docs-prose :global(td .docs-table-copy-btn:hover) {
      opacity: 1;
      color: var(--color-brand-600);
    }
  </style>

  <script>
    const btn = document.getElementById('docs-nav-btn');
    const drawer = document.getElementById('docs-nav-drawer');
    const backdrop = document.getElementById('docs-nav-backdrop');
    const closeBtn = document.getElementById('docs-nav-close');

    function openDrawer() {
      drawer?.classList.remove('hidden');
      btn?.setAttribute('aria-expanded', 'true');
    }
    function closeDrawer() {
      drawer?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    }

    btn?.addEventListener('click', openDrawer);
    backdrop?.addEventListener('click', closeDrawer);
    closeBtn?.addEventListener('click', closeDrawer);

    // Add copy buttons to all <pre> code blocks
    document.querySelectorAll('.docs-prose pre').forEach(pre => {
      pre.style.position = 'relative';
      const copyBtn = document.createElement('button');
      copyBtn.className = 'docs-copy-btn';
      copyBtn.setAttribute('aria-label', 'Copy to clipboard');
      copyBtn.innerHTML = '<svg class="copy-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg><svg class="check-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display:none"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>';
      copyBtn.addEventListener('click', async () => {
        const code = pre.querySelector('code') || pre;
        await navigator.clipboard.writeText(code.textContent?.trim() || '');
        const ci = copyBtn.querySelector('.copy-icon');
        const ch = copyBtn.querySelector('.check-icon');
        ci.style.display = 'none';
        ch.style.display = 'block';
        setTimeout(() => { ci.style.display = 'block'; ch.style.display = 'none'; }, 1500);
      });
      pre.appendChild(copyBtn);
    });

    // Add copy buttons to inline code inside table cells
    document.querySelectorAll('.docs-prose td code').forEach(code => {
      const btn = document.createElement('button');
      btn.className = 'docs-table-copy-btn';
      btn.setAttribute('aria-label', 'Copy to clipboard');
      btn.innerHTML = '<svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>';
      btn.addEventListener('click', async () => {
        await navigator.clipboard.writeText(code.textContent?.trim() || '');
        btn.innerHTML = '<svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>';
        setTimeout(() => {
          btn.innerHTML = '<svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>';
        }, 1500);
      });
      code.after(btn);
    });
  </script>

</BaseLayout>
